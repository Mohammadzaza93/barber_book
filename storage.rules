rules_version = '2';

// Free-tier safe Storage rules: signed-in shop owner only, images only, size capped.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isShopOwner(shopId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/shops/$(shopId)).data.ownerId
          == request.auth.uid;
    }

    function isImageUnder5mb() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /shops/{shopId}/logo {
      allow read: if isShopOwner(shopId);
      allow write: if isShopOwner(shopId) && isImageUnder5mb();
    }

    // Backups metadata only lives in Firestore; block arbitrary storage paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
