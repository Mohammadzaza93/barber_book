rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isShopOwner(shopId) {
      return signedIn() && shopDoc(shopId).ownerId == request.auth.uid;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isShopMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    function myRole(shopId) {
      return get(memberPath(shopId)).data.role;
    }

    function isManager(shopId) {
      return isShopOwner(shopId)
        || (isShopMember(shopId) && myRole(shopId) == 'manager');
    }

    function isStaff(shopId) {
      return isShopMember(shopId) && myRole(shopId) == 'staff';
    }

    function canReadShopData(shopId) {
      return isShopOwner(shopId) || isShopMember(shopId);
    }

    function belongsToShop(data, shopId) {
      return data.shopId == shopId;
    }

    function appointmentMutableFields() {
      return [
        'customerName', 'customerPhone', 'customerEmail',
        'employeeId', 'chairId', 'serviceIds', 'startTime', 'endTime',
        'status', 'paymentStatus', 'totalAmount', 'depositAmount',
        'discountCode', 'discountAmount', 'notes', 'recurring', 'seriesId',
        'outOfHours', 'reminderSent', 'rating'
      ];
    }

    function isAppointmentManagerUpdate(shopId) {
      return isManager(shopId)
        && belongsToShop(request.resource.data, shopId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdById == resource.data.createdById
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(appointmentMutableFields());
    }

    // Staff can only edit the customer-facing notes/contact details of an
    // appointment they created. Status, payment and schedule changes belong
    // to a manager. This also makes future customer/employee identity checks
    // possible without widening write access again.
    function isStaffAppointmentUpdate(shopId) {
      return isStaff(shopId)
        && resource.data.createdById == request.auth.uid
        && belongsToShop(request.resource.data, shopId)
        && request.resource.data.createdById == resource.data.createdById
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerName', 'customerPhone', 'customerEmail', 'notes'
        ]);
    }

    match /shops/{shopId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if isShopOwner(shopId) || isShopMember(shopId);
      allow update, delete: if isShopOwner(shopId);

      match /members/{memberId} {
        allow read: if isShopOwner(shopId)
          || (signedIn() && request.auth.uid == memberId);
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.uid == memberId
          && request.resource.data.role == 'staff';
        allow update, delete: if isShopOwner(shopId);
      }

      // The current client loads the operational calendar for shop members.
      // Until customer-facing public reads are moved behind a server endpoint,
      // keep reads compatible while restricting all sensitive writes below.
      match /appointments/{docId} {
        allow read: if canReadShopData(shopId);
        allow create: if belongsToShop(request.resource.data, shopId)
          && (isManager(shopId)
            || (isStaff(shopId)
              && request.resource.data.createdById == request.auth.uid));
        allow update: if isAppointmentManagerUpdate(shopId)
          || isStaffAppointmentUpdate(shopId);
        allow delete: if isManager(shopId);
      }

      // Financial records are manager-owned. A staff member must not create,
      // alter, or delete expenses or payment records from the client.
      match /expenses/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      match /payments/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      // A staff member may submit an out-of-hours request, but only a manager
      // may approve, reject, or delete it.
      match /requests/{docId} {
        allow read: if isManager(shopId) || isStaff(shopId);
        allow create: if isManager(shopId) || isStaff(shopId);
        allow update, delete: if isManager(shopId);
      }

      // Ratings are append-only from the client. Moderation is manager-only.
      // A future public customer endpoint should replace the member read rule.
      match /feedback/{docId} {
        allow read: if isManager(shopId);
        allow create: if canReadShopData(shopId);
        allow update: if isManager(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['showOnPage']);
        allow delete: if isManager(shopId);
      }

      // Customer and loyalty records contain personal and business data.
      match /customers/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      match /loyalty/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      match /queue/{docId} {
        allow read, create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      // Catalog and configuration writes remain owner-only. This prevents a
      // staff account from changing prices, services, staff definitions, or
      // reward rules even if the UI is bypassed.
      match /services/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /employees/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /discounts/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /portfolio/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairs/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairSupplies/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairWeeklyProfits/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /loyaltyRules/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /loyaltyGifts/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
