rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isShopOwner(shopId) {
      return signedIn() && shopDoc(shopId).ownerId == request.auth.uid;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isShopMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    function myRole(shopId) {
      return get(memberPath(shopId)).data.role;
    }

    function isManager(shopId) {
      return isShopOwner(shopId)
        || (isShopMember(shopId) && myRole(shopId) == 'manager');
    }

    function isStaff(shopId) {
      return isShopMember(shopId) && myRole(shopId) == 'staff';
    }

    function canReadShopData(shopId) {
      return isShopOwner(shopId) || isShopMember(shopId);
    }

    match /shops/{shopId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if isShopOwner(shopId) || isShopMember(shopId);
      allow update, delete: if isShopOwner(shopId);

      // Membership is granted only by the joinShopByCode callable, which
      // resolves the join code server side and always writes the lowest role.
      // A client can no longer insert or promote its own member document.
      match /members/{memberId} {
        allow read: if isShopOwner(shopId)
          || (signedIn() && request.auth.uid == memberId);
        allow update, delete: if isShopOwner(shopId);
      }

      // Appointments are fully server authoritative: pricing, duration,
      // status, payment state, reminders and ratings are all written by the
      // callables with the Admin SDK, which bypasses these rules. Blocking
      // client writes is what makes that guarantee hold, so there is no
      // partial-write path left to reason about.
      match /appointments/{docId} {
        allow read: if canReadShopData(shopId);
        allow create, update, delete: if false;
      }

      // Booking locks are internal to the conflict detector. A client that can
      // write them could clear or forge a lock and double book a slot.
      match /bookingLocks/{docId} {
        allow read, write: if false;
      }

      // Idempotency claims. Server only, otherwise a client could reserve a
      // requestId and suppress a legitimate retry from another device.
      match /bookingRequests/{docId} {
        allow read, write: if false;
      }

      // Financial records are manager-owned. A staff member must not create,
      // alter, or delete expenses or payment records from the client.
      match /expenses/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      // Payment records are created, corrected and deleted exclusively by the
      // updateAppointment callable, so that collectedAmount and the derived
      // paymentStatus can never disagree and no client can invent a collection.
      // Managers keep read access for the reports screens.
      match /payments/{docId} {
        allow read: if isManager(shopId);
        allow write: if false;
      }

      // A staff member may submit an out-of-hours request, but only a manager
      // may approve, reject, or delete it.
      match /requests/{docId} {
        allow read: if isManager(shopId) || isStaff(shopId);
        allow create: if isManager(shopId) || isStaff(shopId);
        allow update, delete: if isManager(shopId);
      }

      // Ratings are append-only from the client. Moderation is manager-only.
      // A future public customer endpoint should replace the member read rule.
      match /feedback/{docId} {
        allow read: if isManager(shopId);
        allow create: if canReadShopData(shopId);
        allow update: if isManager(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['showOnPage']);
        allow delete: if isManager(shopId);
      }

      // Customer and loyalty records contain personal and business data.
      match /customers/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      match /loyalty/{docId} {
        allow read: if isManager(shopId);
        allow create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      match /queue/{docId} {
        allow read, create, update: if isManager(shopId);
        allow delete: if isManager(shopId);
      }

      // Stock levels and the movement log that feeds them. Movements are
      // append-only from the client so a staff account cannot quietly rewrite
      // the history behind a quantity, and both are manager scoped because the
      // admin home exposes the inventory tab to every role.
      match /inventory/{docId} {
        allow read, create, update, delete: if isManager(shopId);
      }

      match /inventoryMovements/{docId} {
        allow read: if isManager(shopId);
        allow create: if isManager(shopId);
        allow update, delete: if false;
      }

      // Catalog and configuration writes remain owner-only. This prevents a
      // staff account from changing prices, services, staff definitions, or
      // reward rules even if the UI is bypassed.
      match /services/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /employees/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      // The owner edits the coupon, but never its redemption counter. Usage is
      // incremented by the createAppointment callable inside the booking
      // transaction, so a client cannot mint extra discounts.
      match /discounts/{docId} {
        allow read: if canReadShopData(shopId);
        allow create: if isShopOwner(shopId)
          && (!('usageCount' in request.resource.data)
            || request.resource.data.usageCount == 0);
        allow update: if isShopOwner(shopId)
          && request.resource.data.usageCount == resource.data.usageCount;
        allow delete: if isShopOwner(shopId);
      }

      match /portfolio/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairs/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairSupplies/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /chairWeeklyProfits/{docId} {
        allow read: if isManager(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /loyaltyRules/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }

      match /loyaltyGifts/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isShopOwner(shopId);
      }
    }

    // A user profile is readable by its owner and writable by nobody on the
    // client. The shop binding (joinedShopId) is written by joinShopByCode,
    // which is the only place membership is granted.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
