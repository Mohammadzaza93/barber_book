rules_version = '2';

// Free security baseline.
// Critical: collection query shops.where(ownerId==uid) needs list rule on resource.data.ownerId.
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isShopOwner(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && shopDoc(shopId).ownerId == request.auth.uid;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isShopMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    function myRole(shopId) {
      return get(memberPath(shopId)).data.role;
    }

    function isAdmin(shopId) {
      return isShopOwner(shopId)
        || (isShopMember(shopId)
            && myRole(shopId) in ['admin', 'manager', 'owner']);
    }

    function isStaff(shopId) {
      return isShopMember(shopId) && myRole(shopId) == 'staff';
    }

    function canReadShopData(shopId) {
      return isShopOwner(shopId) || isShopMember(shopId);
    }

    match /shops/{shopId} {
      // Create shop: signed-in user becomes owner
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // GET one shop by id: owner or member
      allow get: if isShopOwner(shopId) || isShopMember(shopId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      // LIST / query shops.where(ownerId == uid) — must use resource.data
      allow list: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow update: if isAdmin(shopId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isShopOwner(shopId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Owner/admin: full access to every subcollection under the shop
      match /{document=**} {
        allow read, write: if isAdmin(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }

      match /members/{memberId} {
        allow read: if isShopOwner(shopId) || isAdmin(shopId)
          || (signedIn() && request.auth.uid == memberId);
        allow create, update, delete: if isShopOwner(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }

      match /appointments/{docId} {
        allow read: if canReadShopData(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
        allow create, update: if isAdmin(shopId) || isStaff(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
        allow delete: if isAdmin(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }

      match /queue/{docId} {
        allow read, create, update: if isAdmin(shopId) || isStaff(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
        allow delete: if isAdmin(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }

      match /services/{docId} {
        allow read: if canReadShopData(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
        allow write: if isAdmin(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }

      match /employees/{docId} {
        allow read: if canReadShopData(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
        allow write: if isAdmin(shopId)
          || (signedIn()
              && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId
                 == request.auth.uid);
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
