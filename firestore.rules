rules_version = '2';

// BarberBook — internal app for ONE salon (owner + staff).
//
// Security model
// --------------
// * The shop owner is identified by the immutable `ownerId` field on
//   `shops/{shopId}`. Only OWNER_EMAIL may create a shop, and `ownerId` can
//   never be changed after creation.
// * Roles live ONLY in `shops/{shopId}/members/{uid}`. `/users` is gone.
// * A member document is written by the owner only and carries both `role`
//   (admin/staff) and the `permissions` map. Server rules enforce the same
//   granular permissions the UI uses, so a staff client cannot reach finance,
//   settings, backups, members or the employee roster by calling Firestore
//   directly.
// * There is no catch-all grant. Every collection is listed explicitly; any
//   new collection is denied until it is added here on purpose.
//
// OWNER_EMAIL below must match `kOwnerEmail` in lib/config/owner.dart.
// Deploy only after `npm test` in the rules-test project passes.

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function shopRef(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function memberRef(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isOwner(shopId) {
      return signedIn()
        && exists(shopRef(shopId))
        && get(shopRef(shopId)).data.ownerId == request.auth.uid;
    }

    // A member document with `active: false` is a deactivated account: it keeps
    // its identity but loses every grant below. A missing field means active.
    function isMember(shopId) {
      return signedIn()
        && exists(memberRef(shopId))
        && get(memberRef(shopId)).data.get('active', true) != false;
    }

    function memberRole(shopId) {
      return get(memberRef(shopId)).data.role;
    }

    // 'owner' and 'manager' are legacy names that the client maps to admin.
    function isAdminMember(shopId) {
      return isMember(shopId)
        && memberRole(shopId) in ['admin', 'owner', 'manager'];
    }

    function isAdmin(shopId) {
      return isOwner(shopId) || isAdminMember(shopId);
    }

    // Granular, owner-controlled capability from the member document.
    function perm(shopId, key) {
      return isMember(shopId)
        && get(memberRef(shopId)).data.get('permissions', {}).get(key, false) == true;
    }

    function can(shopId, key) {
      return isAdmin(shopId) || perm(shopId, key);
    }

    // A pairing invite is an owner-issued, high-entropy code bound to one
    // email. The claimant must be signed in with that same Auth email; role and
    // permissions are copied verbatim from the invite, never chosen by the
    // claimant.
    function inviteRef(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function claimMatchesInvite(shopId, code) {
      let invite = get(inviteRef(code)).data;
      return signedIn()
        && request.auth.token.email != null
        && invite.shopId == shopId
        && invite.email == request.auth.token.email.lower()
        && invite.active == true
        && invite.expiresAt is timestamp
        && invite.expiresAt > request.time
        && invite.role == request.resource.data.role
        && invite.permissions == request.resource.data.permissions;
    }

    function canClaimInvite(shopId) {
      let code = request.resource.data.get('inviteCode', '');
      return code is string
        && code != ''
        && exists(inviteRef(code))
        && claimMatchesInvite(shopId, code);
    }

    // ------------------------------------------------------------- collection
    match /shops/{shopId} {
      // The single salon owner may bootstrap the shop. Anyone else — including
      // a signed-in stranger — is rejected here even if they reach the API.
      allow create: if signedIn()
        && request.auth.token.email == 'mohammad93zza@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.data.ownerId == request.auth.uid;

      allow get: if isOwner(shopId) || isMember(shopId);

      // Used by findShopByOwner(uid) during session restore.
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Settings can be edited by the owner or by a member explicitly granted
      // the `settings` capability, but ownership is immutable forever.
      allow update: if (isOwner(shopId) || perm(shopId, 'settings'))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(shopId);

      // ------------------------------------------------------------- members
      match /members/{memberId} {
        allow get: if isAdmin(shopId)
          || (signedIn() && request.auth.uid == memberId);
        allow list: if isAdmin(shopId);

        // Only the true owner manages membership. Admins cannot promote
        // themselves or anyone else. The one narrow exception is a signed-in
        // account claiming an owner-issued pairing invite for its own verified
        // Auth email: it may only create *itself* with the invite's exact role
        // and permissions.
        allow create: if (isOwner(shopId)
            && request.resource.data.uid == memberId
            && request.resource.data.role in ['admin', 'staff']
            && request.resource.data.permissions is map)
          || (signedIn()
            && request.auth.uid == memberId
            && request.auth.token.email != null
            && request.resource.data.uid == memberId
            && request.resource.data.email == request.auth.token.email.lower()
            && request.resource.data.role in ['admin', 'staff']
            && request.resource.data.permissions is map
            && request.resource.data.active == true
            && canClaimInvite(shopId));

        // The owner can change anything. An admin member may only adjust a
        // *staff* member's capabilities / active flag / contact details: never
        // a role, never another admin, never themselves.
        allow update: if (isOwner(shopId)
            && request.resource.data.uid == memberId
            && request.resource.data.role in ['admin', 'staff']
            && request.resource.data.permissions is map)
          || (isAdminMember(shopId)
            && memberId != request.auth.uid
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && request.resource.data.uid == memberId
            && request.resource.data.permissions is map
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['permissions', 'active', 'name', 'email']));
        allow delete: if isOwner(shopId);
      }

      // -------------------------------------------------------------- services
      match /services/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'services');
      }

      // ------------------------------------------------------------- employees
      match /employees/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow create: if can(shopId, 'staff');
        // A paired account may attach its own trusted uid to a roster document
        // that is still unlinked. It can only touch the null `authUid` field and
        // only for the email bound to its own Auth token.
        allow update: if can(shopId, 'staff')
          || (isMember(shopId)
            && request.auth.token.email != null
            && resource.data.email is string
            && resource.data.email.lower() == request.auth.token.email.lower()
            && (resource.data.authUid == null || resource.data.authUid == '')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['authUid'])
            && request.resource.data.authUid == request.auth.uid);
        allow delete: if isAdmin(shopId);
      }

      // ----------------------------------------------------------- appointments
      // Staff may schedule/update an appointment, but cannot rewrite pricing,
      // discounts or the creating identity of an existing booking.
      function appointmentUpdateAllowed() {
        return isAdmin(shopId)
          // Data entry: status + contact fields only. Times, services, barber,
          // prices and payment fields can never be rewritten from here.
          || (perm(shopId, 'appointments')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'notes', 'customerName', 'customerPhone',
                'customerEmail', 'reminderSent', 'rating', 'updatedAt'
              ])
              && request.resource.data.status in
                   ['requested', 'confirmed', 'completed', 'cancelled', 'noShow'])
          // Payment capability: only the collected total and its status, and
          // never above what the appointment costs.
          || (perm(shopId, 'payments')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paymentStatus', 'collectedAmount'
              ])
              && request.resource.data.paymentStatus in
                   ['unpaid', 'depositPaid', 'paid']
              && request.resource.data.collectedAmount is number
              && request.resource.data.collectedAmount >= 0
              && request.resource.data.collectedAmount
                   <= resource.data.totalAmount + 0.01);
      }

      match /appointments/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        // A new booking always starts unpaid with nothing collected, so a
        // data-entry account cannot book something as already completed/paid.
        allow create: if can(shopId, 'appointments')
          && request.resource.data.createdById == request.auth.uid
          && request.resource.data.shopId == shopId
          && request.resource.data.status in ['requested', 'confirmed']
          && request.resource.data.paymentStatus == 'unpaid'
          && request.resource.data.collectedAmount == 0
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount >= 0
          && request.resource.data.startTime is timestamp
          && request.resource.data.endTime is timestamp
          && request.resource.data.startTime < request.resource.data.endTime
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0
          && request.resource.data.customerName.size() <= 120;
        allow update: if appointmentUpdateAllowed();
        allow delete: if isAdmin(shopId);
      }

      // ------------------------------------------------------------------ queue
      match /queue/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        // Any staff member may run the walk-in queue; payments are guarded
        // separately by the `payments` collection rule.
        allow create, update: if isMember(shopId);
        allow delete: if isAdmin(shopId);
      }

      // --------------------------------------------------------------- payments
      // A payment is a ledger entry: it can be added, never edited. Removing
      // one (a mistake) is an admin action.
      match /payments/{docId} {
        allow read: if can(shopId, 'payments');
        allow create: if can(shopId, 'payments')
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update: if false;
        allow delete: if isAdmin(shopId);
      }

      // -------------------------------------------------------------- discounts
      match /discounts/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'discounts');
      }

      // --------------------------------------------------------------- feedback
      match /feedback/{docId} {
        allow read, write: if can(shopId, 'feedback');
      }

      // ------------------------------------------------- out-of-hours requests
      match /requests/{docId} {
        allow read, write: if can(shopId, 'outOfHours');
      }

      // -------------------------------------------------------------- portfolio
      match /portfolio/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'businessTools');
      }

      // -------------------------------------------------------------- customers
      match /customers/{docId} {
        allow read, write: if can(shopId, 'appointments')
          || can(shopId, 'payments')
          || can(shopId, 'businessTools');
      }

      // ---------------------------------------------------------------- loyalty
      match /loyalty/{docId} {
        allow read, write: if can(shopId, 'businessTools')
          || can(shopId, 'discounts');
      }

      match /loyaltyRules/{docId} {
        allow read, write: if can(shopId, 'businessTools')
          || can(shopId, 'discounts');
      }

      match /loyaltyGifts/{docId} {
        allow read, write: if can(shopId, 'businessTools');
      }

      // ------------------------------------------------------- chairs / profits
      match /chairs/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'businessTools') || can(shopId, 'finance');
      }

      match /chairSupplies/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'businessTools') || can(shopId, 'finance');
      }

      match /chairWeeklyProfits/{docId} {
        allow read, write: if can(shopId, 'businessTools') || can(shopId, 'finance');
      }

      // -------------------------------------------------------------- inventory
      // Checkout consumes stock automatically, so `payments` also grants the
      // narrow write needed for that flow.
      match /inventory/{docId} {
        allow read, write: if can(shopId, 'businessTools')
          || can(shopId, 'finance')
          || can(shopId, 'payments');
      }

      // Stock movements are an append-only history.
      match /inventoryMovements/{docId} {
        allow read, create: if can(shopId, 'businessTools')
          || can(shopId, 'finance')
          || can(shopId, 'payments');
        allow update, delete: if false;
      }

      // Stocktake sessions. A session snapshots expected quantities and later
      // applies counted quantities through the same inventory writes above.
      // Completed sessions are the audit trail: only untouched or cancelled
      // sessions may be deleted.
      match /stocktakes/{docId} {
        allow read: if can(shopId, 'businessTools')
          || can(shopId, 'finance')
          || can(shopId, 'payments');
        // Sessions are born as drafts. A submitted/cancelled session is an
        // audit record and becomes immutable to every client.
        allow create: if (can(shopId, 'businessTools')
            || can(shopId, 'finance')
            || can(shopId, 'payments'))
          && request.resource.data.status == 'draft';
        allow update: if (can(shopId, 'businessTools')
            || can(shopId, 'finance')
            || can(shopId, 'payments'))
          && resource.data.status in ['draft', 'posting'];
        allow delete: if (can(shopId, 'businessTools')
            || can(shopId, 'finance')
            || can(shopId, 'payments'))
          && resource.data.status in ['draft', 'cancelled'];
      }

      // ------------------------------------------------------------- team hub
      match /team_tasks/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'staff');
      }

      match /team_evaluations/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'staff');
      }

      match /team_attendance/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'staff');
      }

      match /team_time_off/{docId} {
        allow read: if isMember(shopId) || isOwner(shopId);
        allow write: if can(shopId, 'staff');
      }

      // --------------------------------------------------------------- finance
      match /finance/{bucket}/{docId} {
        allow read, write: if can(shopId, 'finance');
      }

      match /finance/{bucket}/items/{itemId} {
        allow read, write: if can(shopId, 'finance');
      }

      // Daily revenue is written by the queue checkout, which staff are
      // allowed to run when they hold the `payments` capability.
      match /finance_daily/{docId} {
        allow read, create, update: if can(shopId, 'finance') || can(shopId, 'payments');
        allow delete: if isAdmin(shopId);
      }

      match /day_closes/{docId} {
        allow read, create, update: if can(shopId, 'finance') || can(shopId, 'payments');
        allow delete: if isAdmin(shopId);
      }

      // ----------------------------------------------------------- audit trail
      // Append-only: any member may add an entry attributed to themselves,
      // but nobody can rewrite or erase history.
      match /activity_log/{docId} {
        allow read: if isAdmin(shopId) || perm(shopId, 'reports');
        allow create: if isMember(shopId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // ---------------------------------------------------------------- backups
      match /backups/{docId} {
        allow read, write: if isAdmin(shopId);
      }
    }

    // Pointer to the salon, read by any signed-in account so a staff login can
    // reach its own members/{uid} document without a collection-group index.
    // Only the shop owner may write it, and only for a shop they own.
    match /appConfig/{docId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if docId == 'primaryShop'
        && request.resource.data.keys().hasOnly(['shopId', 'updatedAt'])
        && request.resource.data.shopId is string
        && isOwner(request.resource.data.shopId);
      allow delete: if false;
    }

    // Owner-issued pairing invites for accounts that already exist in Firebase
    // Auth. The random document id is the secret. Reading is restricted to the
    // invited Auth email; only the true owner creates/updates one.
    match /invites/{code} {
      allow get: if signedIn()
        && request.auth.token.email != null
        && resource.data.get('email', '') == request.auth.token.email.lower();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.shopId is string
        && isOwner(request.resource.data.shopId)
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.permissions is map
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn() && isOwner(resource.data.shopId);
      // The intended account may discard/consume its own code; nobody else.
      allow delete: if signedIn()
        && (isOwner(resource.data.shopId)
          || (request.auth.token.email != null
            && resource.data.email == request.auth.token.email.lower()));
    }

    // Direct self-readable membership pointer: `memberships/{uid}`.
    // Session restore reads this one document, so a staff login does not depend
    // on the collection-group index for a `members.uid` query. The canonical
    // role/permissions still live in `shops/{shopId}/members/{uid}`; the owner
    // keeps this mirror in sync. Nobody else may read another account's pointer.
    match /memberships/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isOwner(request.resource.data.shopId)
        && request.resource.data.uid == uid
        && request.resource.data.shopId is string
        && request.resource.data.permissions is map;
      // Merge-safe: an update may send only the changed capability fields.
      allow update: if isOwner(request.resource.data.get('shopId', resource.data.shopId))
        && request.resource.data.get('uid', resource.data.uid) == uid
        && request.resource.data.get('permissions', resource.data.permissions) is map;
      allow delete: if signedIn() && isOwner(resource.data.shopId);
    }

    // Membership lookup used by resolveShopForUser (collection-group query).
    // The rule mirrors the query constraint, so Firestore can prove it.
    match /{path=**}/members/{memberId} {
      allow list, get: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
