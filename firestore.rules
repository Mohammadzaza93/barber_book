rules_version = '2';

// Free security baseline: deny-by-default, shop isolation, role checks.
// Owner/admin has full access to all shop subcollections (restores app data).
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isShopOwner(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && shopDoc(shopId).ownerId == request.auth.uid;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isShopMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    function myRole(shopId) {
      return get(memberPath(shopId)).data.role;
    }

    // Matches app AppRoleX: admin/owner/manager → admin
    function isAdmin(shopId) {
      return isShopOwner(shopId)
        || (isShopMember(shopId)
            && myRole(shopId) in ['admin', 'manager', 'owner']);
    }

    function isStaff(shopId) {
      return isShopMember(shopId) && myRole(shopId) == 'staff';
    }

    function canReadShopData(shopId) {
      return isShopOwner(shopId) || isShopMember(shopId);
    }

    match /shops/{shopId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if isShopOwner(shopId) || isShopMember(shopId);
      allow update: if isAdmin(shopId);
      allow delete: if isShopOwner(shopId);

      // Safety net: owner/admin can access ANY subcollection under the shop.
      match /{document=**} {
        allow read, write: if isAdmin(shopId);
      }

      match /members/{memberId} {
        allow read: if isShopOwner(shopId) || isAdmin(shopId)
          || (signedIn() && request.auth.uid == memberId);
        allow create: if isShopOwner(shopId);
        allow update, delete: if isShopOwner(shopId);
      }

      match /appointments/{docId} {
        allow read: if canReadShopData(shopId);
        allow create, update: if isAdmin(shopId) || isStaff(shopId);
        allow delete: if isAdmin(shopId);
      }

      match /expenses/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /payments/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /finance/{group}/items/{itemId} {
        allow read, write: if isAdmin(shopId);
      }

      match /finance_daily/{entryId} {
        allow read, write: if isAdmin(shopId);
      }

      match /requests/{docId} {
        allow read, create, update: if isAdmin(shopId) || isStaff(shopId);
        allow delete: if isAdmin(shopId);
      }

      match /feedback/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /customers/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /loyalty/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /queue/{docId} {
        allow read, create, update: if isAdmin(shopId) || isStaff(shopId);
        allow delete: if isAdmin(shopId);
      }

      match /inventory/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /inventoryMovements/{docId} {
        allow read, create: if isAdmin(shopId);
        allow update, delete: if false;
      }

      match /services/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /employees/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /discounts/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /portfolio/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /chairs/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /chairSupplies/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /chairWeeklyProfits/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /loyaltyRules/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /loyaltyGifts/{docId} {
        allow read: if canReadShopData(shopId);
        allow write: if isAdmin(shopId);
      }

      match /team_tasks/{docId} {
        allow read: if canReadShopData(shopId);
        allow create, update: if isAdmin(shopId) || isStaff(shopId);
        allow delete: if isAdmin(shopId);
      }

      match /team_evaluations/{docId} {
        allow read, write: if isAdmin(shopId);
      }

      match /team_attendance/{docId} {
        allow read: if isAdmin(shopId) || isStaff(shopId);
        allow write: if isAdmin(shopId);
      }

      match /team_time_off/{docId} {
        allow read: if canReadShopData(shopId);
        allow create: if isAdmin(shopId) || isStaff(shopId);
        allow update, delete: if isAdmin(shopId);
      }

      match /activity_log/{docId} {
        allow read: if isAdmin(shopId);
        allow create: if isAdmin(shopId) || isStaff(shopId);
        allow update, delete: if false;
      }

      match /backups/{docId} {
        allow read, write: if isAdmin(shopId);
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
